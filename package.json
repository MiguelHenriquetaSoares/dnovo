    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@ionic/vue": "9.0.6",
    "@ionic/vue-router": "9.0.6",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
